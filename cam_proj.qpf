QUARTUS_VERSION = "13.0"
DATE = "11:26:58  April 11, 2016"

# Revisions

PROJECT_REVISION = "cam_proj"

# ==============================================================================
# 时钟与复位
# ==============================================================================
set_location_assignment PIN_E1  -to clk50           # 50MHz 系统时钟
set_location_assignment PIN_M15 -to rst             # 复位按键 (KEY0)
set_location_assignment PIN_M2  -to start_gray_kn   # 开始识别按键 (KEY1)

# ==============================================================================
# SDRAM (W9825G6KH-6) - 对应规格书 Page 15-16
# ==============================================================================
set_location_assignment PIN_R4  -to sdram_clk       # SDRAM 时钟
set_location_assignment PIN_R9  -to Cke             # 时钟使能
set_location_assignment PIN_R12 -to cs_n            # 片选
set_location_assignment PIN_R11 -to ras_n           # 行选通
set_location_assignment PIN_R10 -to cas_n           # 列选通
set_location_assignment PIN_L9  -to we_n            # 写使能
set_location_assignment PIN_R14 -to ba[0]           # Bank地址
set_location_assignment PIN_R13 -to ba[1]
set_location_assignment PIN_M10 -to dqm[0]          # 数据掩码
set_location_assignment PIN_M9  -to dqm[1]

# SDRAM 地址总线
set_location_assignment PIN_P11 -to sd_addr[0]
set_location_assignment PIN_P14 -to sd_addr[1]
set_location_assignment PIN_N9  -to sd_addr[2]
set_location_assignment PIN_N11 -to sd_addr[3]
set_location_assignment PIN_T14 -to sd_addr[4]
set_location_assignment PIN_T13 -to sd_addr[5]
set_location_assignment PIN_T12 -to sd_addr[6]
set_location_assignment PIN_T11 -to sd_addr[7]
set_location_assignment PIN_T10 -to sd_addr[8]
set_location_assignment PIN_P9  -to sd_addr[9]
set_location_assignment PIN_T15 -to sd_addr[10]
set_location_assignment PIN_N12 -to sd_addr[11]

# SDRAM 数据总线
set_location_assignment PIN_R3  -to sd_data[0]
set_location_assignment PIN_T9  -to sd_data[1]
set_location_assignment PIN_R5  -to sd_data[2]
set_location_assignment PIN_R6  -to sd_data[3]
set_location_assignment PIN_R7  -to sd_data[4]
set_location_assignment PIN_M8  -to sd_data[5]
set_location_assignment PIN_R8  -to sd_data[6]
set_location_assignment PIN_N8  -to sd_data[7]
set_location_assignment PIN_P8  -to sd_data[8]
set_location_assignment PIN_T8  -to sd_data[9]
set_location_assignment PIN_T7  -to sd_data[10]
set_location_assignment PIN_T6  -to sd_data[11]
set_location_assignment PIN_T5  -to sd_data[12]
set_location_assignment PIN_T4  -to sd_data[13]
set_location_assignment PIN_T3  -to sd_data[14]
set_location_assignment PIN_T2  -to sd_data[15]

# ==============================================================================
# 摄像头接口 (OV7670) - 对应规格书 Page 43 (DVP接口)
# ==============================================================================
set_location_assignment PIN_M16 -to PCLK_cam        # 像素时钟
set_location_assignment PIN_C16 -to VSYNC_cam       # 场同步
set_location_assignment PIN_J13 -to HREF_cam        # 行同步
set_location_assignment PIN_D15 -to XCLK_cam        # 输出给摄像头的时钟
set_location_assignment PIN_F16 -to res_cam         # 复位
set_location_assignment PIN_G11 -to on_off_cam      # Power Down
set_location_assignment PIN_P15 -to sioc            # SCCB 时钟 (SCL)
set_location_assignment PIN_N14 -to siod            # SCCB 数据 (SDA)

# 摄像头数据总线 (D0-D7)
set_location_assignment PIN_G15 -to data_cam[0]
set_location_assignment PIN_F15 -to data_cam[1]
set_location_assignment PIN_F14 -to data_cam[2]
set_location_assignment PIN_D16 -to data_cam[3]
set_location_assignment PIN_C15 -to data_cam[4]
set_location_assignment PIN_B16 -to data_cam[5]
set_location_assignment PIN_F13 -to data_cam[6]
set_location_assignment PIN_L13 -to data_cam[7]

# ==============================================================================
# SPI 屏幕接口 (ILI9341)
# 重要：板子没有SPI屏幕接口，这里分配到了 CN2 (40Pin扩展口)
# 请使用杜邦线连接屏幕
# ==============================================================================
# 对应 CN2 的 Pin 5 (F10)
set_location_assignment PIN_F10 -to tft_sck         
# 对应 CN2 的 Pin 6 (F2)
set_location_assignment PIN_F2  -to tft_sdi         # MOSI
# 对应 CN2 的 Pin 7 (F3)
set_location_assignment PIN_F3  -to tft_dc          # DC/RS
# 对应 CN2 的 Pin 8 (F5)
set_location_assignment PIN_F5  -to tft_reset       # RST
# 对应 CN2 的 Pin 9 (G1)
set_location_assignment PIN_G1  -to tft_cs          # CS
# 对应 CN2 的 Pin 10 (J2)
set_location_assignment PIN_J2  -to tft_sdo         # MISO

# ==============================================================================
# LED 指示灯 - 对应规格书 Page 21
# ==============================================================================
set_location_assignment PIN_L7  -to LED[0]          # LED1
set_location_assignment PIN_M6  -to LED[1]          # LED2
set_location_assignment PIN_P3  -to LED[2]          # LED3
set_location_assignment PIN_N3  -to LED[3]          # LED4
# LED[4] 到 LED[7] 在板子上没有，这几行可以忽略或保留为空

# ==============================================================================
# VGA 接口 (仅颜色信号，你的代码缺失了 HSYNC/VSYNC 输出)
# 对应规格书 Page 32
# ==============================================================================
# Red [4:0] 对应板载 VGA_D15~D11
set_location_assignment PIN_A5  -to r[4]
set_location_assignment PIN_E6  -to r[3]
set_location_assignment PIN_E7  -to r[2]
set_location_assignment PIN_B8  -to r[1]
set_location_assignment PIN_A8  -to r[0]

# Green [5:0] 对应板载 VGA_D10~D5
set_location_assignment PIN_F8  -to g[5]
set_location_assignment PIN_E8  -to g[4]
set_location_assignment PIN_B7  -to g[3]
set_location_assignment PIN_A7  -to g[2]
set_location_assignment PIN_F7  -to g[1]
set_location_assignment PIN_F6  -to g[0]

# Blue [4:0] 对应板载 VGA_D4~D0
set_location_assignment PIN_B6  -to b[4]
set_location_assignment PIN_A6  -to b[3]
set_location_assignment PIN_B5  -to b[2]
set_location_assignment PIN_A2  -to b[1]
set_location_assignment PIN_B4  -to b[0]